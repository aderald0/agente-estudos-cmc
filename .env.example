# URL de conexão do PostgreSQL no Neon
DATABASE_URL="postgresql://usuario:senha@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Chave da API do Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY="AIzaSy..."

# Modelo opcional (padrão: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Segredo forte para assinar cookies de sessão HMAC-SHA256 (ex: openssl rand -hex 32)
AUTH_SECRET="gere-uma-string-aleatoria-com-32-caracteres-ou-mais"
