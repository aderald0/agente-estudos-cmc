# URL de conexão do PostgreSQL no Neon (pegue no painel do Neon: Connection String)
DATABASE_URL="postgresql://usuario:senha@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Chave da API do Gemini (pegue gratuitamente em https://aistudio.google.com/apikey)
GEMINI_API_KEY="AIzaSy..."

# Modelo opcional (padrão: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# PIN opcional para proteger o acesso público na Vercel (deixe vazio para acesso direto)
APP_ACCESS_PIN=""
